# Sanity Configuration
# Copy this file to .env.local and fill in your Sanity project details

# Your Sanity Project ID (found in your Sanity project settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Your Sanity Dataset name (usually "production", "development", or "portfolio")
NEXT_PUBLIC_SANITY_DATASET=portfolio

# Sanity API Version (use latest stable, e.g., "2024-01-01")
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: Read token (only needed if your dataset is private)
# You can find this in your Sanity project API settings
SANITY_API_READ_TOKEN=your-read-token-here

