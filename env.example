# Sanity Configuration
# Copy this file to .env.local and fill in your Sanity project details

# Sanity Project ID (portfolio project)
NEXT_PUBLIC_SANITY_PROJECT_ID=19ncek37

# Your Sanity Dataset name (usually "production" or "portfolio")
NEXT_PUBLIC_SANITY_DATASET=portfolio

# Sanity API Version (use latest stable, e.g., "2024-01-01")
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token (required for fetching project data from Sanity)
# Create a token in Sanity project API settings: https://www.sanity.io/manage
SANITY_API_READ_TOKEN=your-read-token-here

